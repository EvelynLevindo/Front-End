# Lumine - Sistema de Gestão Bibliotecária
# Arquivo de Exemplo de Variáveis de Ambiente (Não inserir credenciais de produção aqui)

# Conexão MongoDB (Local ou MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/lumine

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=sua_chave_secreta_jwt_longa_e_aleatoria_aqui

# Tempo de expiração do Token JWT (ex: 7d, 24h, etc.)
JWT_EXPIRES_IN=7d

# Credenciais padrão para o primeiro usuário bibliotecário (seed inicial seguro)
ADMIN_INITIAL_NAME=Felipe Silva
ADMIN_INITIAL_EMAIL=felipe.silva@lereviver.org.br
ADMIN_INITIAL_PASSWORD=Lumine@2024
